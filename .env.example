# Copy this file to .env (same folder) and fill in your values.
# .env is in .gitignore: never commit your real keys.

# ---- Volume knob ----
# 0 as long as the MCP3008 + potentiometer is not wired yet
USE_VOLUME_KNOB=1

# ---- Audio pause ----
# signal = real pause (default), restart = pause stops, resume starts from the beginning
PAUSE_MODE=signal

# ---- ThingSpeak (online dashboard) ----
# Channel ID: on your channel page.
# Client ID / username / password: Devices -> MQTT -> Add a new device (give it access to your channel).
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_CLIENT_ID=
THINGSPEAK_USERNAME=
THINGSPEAK_PASSWORD=

# ---- AI artist facts ----
# API key from console.anthropic.com (needs a little prepaid credit).
# Leave empty to use the fallback facts from records.json.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
